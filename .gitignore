# Java / Maven build output
**/target/
**/out/
**/build/
**/.gradle/
*.class

# Logs and JVM crash dumps
*.log
hs_err_pid*
replay_pid*

# Temporary/editor swap files
*.tmp
*.bak
*.swp
*~

# IDE-specific files (keep curated VS Code extension recommendations)
.idea/
*.iml
.classpath
.project
.settings/
.metadata/
.vscode/*
!.vscode/extensions.json
.mtj.tmp/
.nb-gradle/

# Local environment files and secrets; keep safe examples
.env
.env.*
!.env.example
*.local

# Operating-system metadata
.DS_Store
Thumbs.db
desktop.ini

# BlueJ metadata
*.ctxt

# Local agent-tooling artifacts (kept on disk, not shipped)
.agents/
.opencode/
skills-lock.json
watch-and-test.ps1
